// desired projects spec.forProvider onto the create request body. The JSON
// fields are strings in the CRD and real values on the wire, so they are
// unmarshalled here rather than passed through.
func desired(cr *{{apiVersion}}.{{kind}}) (*{{providerName}}.{{requestModel}}, error) {
	body := &{{providerName}}.{{requestModel}}{}

{{#parameters}}
{{^isParent}}
{{#isJson}}
	if cr.Spec.ForProvider.{{goName}} != "" {
		if err := json.Unmarshal([]byte(cr.Spec.ForProvider.{{goName}}), &body.{{goName}}); err != nil {
			return nil, errors.Wrap(err, "{{jsonName}}")
		}
	}
{{/isJson}}
{{^isJson}}
	body.{{goName}} = {{#needsCast}}{{clientType}}({{/needsCast}}cr.Spec.ForProvider.{{goName}}{{#needsCast}}){{/needsCast}}
{{/isJson}}
{{/isParent}}
{{/parameters}}

	return body, nil
}
{{/hasRequestModel}}

{{#hasResponseModel}}
// observation projects the read response onto status.atProvider.
func observation(in *{{providerName}}.{{responseModel}}) ({{apiVersion}}.{{kind}}Observation, error) {
	out := {{apiVersion}}.{{kind}}Observation{}

{{#observations}}
{{#isJson}}
	if raw, err := json.Marshal(in.{{goName}}); err == nil {
		out.{{goName}} = string(raw)
	} else {
		return out, errors.Wrap(err, "{{jsonName}}")
	}
{{/isJson}}
{{^isJson}}
	out.{{goName}} = {{#needsCast}}{{goType}}({{/needsCast}}in.{{goName}}{{#needsCast}}){{/needsCast}}
{{/isJson}}
{{/observations}}

	return out, nil
}
{{/hasResponseModel}}

// upToDate compares only the fields the server answers under the same name
// and the same shape. A field it does not echo back -- a password, a body the
// server reshapes on the way out -- cannot be diffed without reporting drift
// on every reconcile, so it is left alone.
{{#hasResponseModel}}
func upToDate(cr *{{apiVersion}}.{{kind}}, observed *{{providerName}}.{{responseModel}}) bool {
{{#comparables}}
{{#isJson}}
	if cr.Spec.ForProvider.{{goName}} != "" {
		if raw, err := json.Marshal(observed.{{goName}}); err != nil || !jsonEqual(cr.Spec.ForProvider.{{goName}}, string(raw)) {
			return false
		}
	}
{{/isJson}}
{{^isJson}}
{{#zeroCheck}}
	// Only what the person actually set: an optional field left empty is not
	// a difference from whatever the server chose to put there.
	if cr.Spec.ForProvider.{{goName}} {{{zeroCheck}}} && cr.Spec.ForProvider.{{goName}} != {{#needsCast}}{{goType}}({{/needsCast}}observed.{{goName}}{{#needsCast}}){{/needsCast}} {
		return false
	}
{{/zeroCheck}}
{{^zeroCheck}}
	if cr.Spec.ForProvider.{{goName}} != {{#needsCast}}{{goType}}({{/needsCast}}observed.{{goName}}{{#needsCast}}){{/needsCast}} {
		return false
	}
{{/zeroCheck}}
{{/isJson}}
{{/comparables}}

	return true
}
{{/hasResponseModel}}

{{#anyJson}}
// jsonEqual compares two JSON documents by value rather than by text, so that
// a server re-ordering an object's keys is not a permanent diff.
func jsonEqual(a, b string) bool {
	var left, right any

	if err := json.Unmarshal([]byte(a), &left); err != nil {
		return false
	}
	if err := json.Unmarshal([]byte(b), &right); err != nil {
		return false
	}

	x, err := json.Marshal(left)
	if err != nil {
		return false
	}
	y, err := json.Marshal(right)
	if err != nil {
		return false
	}

	return string(x) == string(y)
}
{{/anyJson}}

func (c *external) Observe(ctx context.Context, cr *{{apiVersion}}.{{kind}}) (managed.ExternalObservation, error) {
{{#hasRead}}
	id := meta.GetExternalName(cr)
	if id == "" {
		// Nothing has been created yet.
		return managed.ExternalObservation{ResourceExists: false}, nil
	}

{{#readHasPathParams}}
	body, err := c.service.DoRequest(ctx, "{{readMethod}}", fmt.Sprintf("{{readPath}}"{{#parents}}, cr.Spec.ForProvider.{{goName}}{{/parents}}, id), nil)
{{/readHasPathParams}}
{{^readHasPathParams}}
	body, err := c.service.DoRequest(ctx, "{{readMethod}}", "{{readPath}}", nil)
{{/readHasPathParams}}
	if err != nil {
		// ONLY a 404 means it is gone. Any other failure (500, timeout,
		// throttling) must be surfaced -- treating it as "does not exist"
		// would provision a second one and orphan the first.
		if {{providerName}}.IsNotFound(err) {
			return managed.ExternalObservation{ResourceExists: false}, nil
		}
		return managed.ExternalObservation{}, errors.Wrap(err, errGet)
	}

	var observed {{providerName}}.{{responseModel}}
	if err := json.Unmarshal(body, &observed); err != nil {
		return managed.ExternalObservation{}, errors.Wrap(err, errParse)
	}

	at, err := observation(&observed)
	if err != nil {
		return managed.ExternalObservation{}, errors.Wrap(err, errParse)
	}
	cr.Status.AtProvider = at

{{#disabledIsGone}}
	// RT deletes this by disabling it, so after a successful delete the read
	// still answers -- and without this the finalizer never comes off. Only
	// while deleting: a disabled {{kindCamel}} nobody asked to delete still
	// exists, and saying otherwise would create a second one.
	if meta.WasDeleted(cr) && observed.Disabled == "1" {
		return managed.ExternalObservation{ResourceExists: false}, nil
	}

{{/disabledIsGone}}
	if meta.WasDeleted(cr) {
		cr.Status.SetConditions(xpv2.Deleting())
	} else {
		cr.Status.SetConditions(xpv2.Available())
	}

	return managed.ExternalObservation{
		ResourceExists:   true,
		ResourceUpToDate: upToDate(cr, &observed),
	}, nil
{{/hasRead}}
{{^hasRead}}
	// This API offers no read for a {{kindCamel}}, so nothing can be observed
	// and nothing can be reported as drifted.
	//
	// Whether it EXISTS cannot come from the external name either:
	// crossplane-runtime's default initializer is NewNameAsExternalName, so
	// the annotation is already set to the resource's own name before the
	// first Observe ever runs. Reading existence off it would report
	// ResourceExists on the first pass, Create would never be called, and the
	// resource would sit there Available having done nothing at all.
	//
	// What this controller does know is whether IT has created the
	// {{kindCamel}} -- which is what the Ready condition it set at the end of
	// Create says, and that condition is persisted with the status.
	if cr.Status.GetCondition(xpv2.TypeReady).Reason != xpv2.ReasonAvailable {
		return managed.ExternalObservation{ResourceExists: false}, nil
	}

	return managed.ExternalObservation{
		ResourceExists:   true,
		ResourceUpToDate: true,
	}, nil
{{/hasRead}}
}

func (c *external) Create(ctx context.Context, cr *{{apiVersion}}.{{kind}}) (managed.ExternalCreation, error) {
{{#hasCreate}}
	cr.Status.SetConditions(xpv2.Creating())

{{#hasRequestModel}}
	body, err := desired(cr)
	if err != nil {
		return managed.ExternalCreation{}, errors.Wrap(err, errParams)
	}
{{/hasRequestModel}}
{{^hasRequestModel}}
	// The document describes this create as taking no body.
	var body interface{}
{{/hasRequestModel}}

	respBody, location, err := c.service.DoCreateRequest(ctx, "{{createMethod}}", {{#hasParents}}fmt.Sprintf("{{createPath}}"{{#parents}}, cr.Spec.ForProvider.{{goName}}{{/parents}}){{/hasParents}}{{^hasParents}}"{{createPath}}"{{/hasParents}}, body)
	if err != nil {
		return managed.ExternalCreation{}, errors.Wrap(err, errCreate)
	}

	id := ""

{{#isSet}}
	// A SET rather than a create: this endpoint replaces what the owning
	// resource has and answers a message, not an identifier. The resource is
	// the owner's {{kindCamel}}s, so the owning id is the external name --
	// there is no other one, and a second apply must address the same thing
	// rather than set the memberships twice.
	id = cr.Spec.ForProvider.{{setIdField}}
	_ = location
	_ = respBody
{{/isSet}}
{{^isSet}}
	// A create that answers 201 with nothing but a Location header. The
	// identifier is in that header, and everything else the server assigned
	// has to be fetched.
{{^hasResponseModel}}
	// Nothing to parse the answer into; the identifier is the Location header
	// or there is none.
	id = {{providerName}}.IDFromLocation(location)
	_ = respBody
{{/hasResponseModel}}
{{#hasResponseModel}}
	if len(respBody) == 0 {
		id = {{providerName}}.IDFromLocation(location)
	} else {
		var created {{providerName}}.{{responseModel}}
		if err := json.Unmarshal(respBody, &created); err != nil {
			return managed.ExternalCreation{}, errors.Wrap(err, errParse)
		}
{{#hasID}}
		// Through %v because RT numbers its ids and an external name is a
		// string -- the annotation has to hold what the member path spells,
		// whichever of the two the document declared.
		id = fmt.Sprintf("%v", created.{{idFieldExported}})
{{/hasID}}
{{^hasID}}
		id = {{providerName}}.IDFromLocation(location)
{{/hasID}}

		at, err := observation(&created)
		if err != nil {
			return managed.ExternalCreation{}, errors.Wrap(err, errParse)
		}
		cr.Status.AtProvider = at
	}
{{/hasResponseModel}}
{{/isSet}}

	if id == "" {
		return managed.ExternalCreation{}, errors.New(errNoID)
	}

	meta.SetExternalName(cr, id)
{{^hasRead}}

	// The only record that this {{kindCamel}} was created: with no read,
	// Observe has nothing else to tell "created" from "not yet".
	cr.Status.SetConditions(xpv2.Available())
{{/hasRead}}

	return managed.ExternalCreation{}, nil
{{/hasCreate}}
{{^hasCreate}}
	return managed.ExternalCreation{}, errors.New("this API offers no create for a {{kindCamel}}")
{{/hasCreate}}
}

func (c *external) Update(ctx context.Context, cr *{{apiVersion}}.{{kind}}) (managed.ExternalUpdate, error) {
{{#hasUpdate}}
	id := meta.GetExternalName(cr)
	if id == "" {
		return managed.ExternalUpdate{}, errors.New(errUpdate)
	}

{{#hasRequestModel}}
	body, err := desired(cr)
	if err != nil {
		return managed.ExternalUpdate{}, errors.Wrap(err, errParams)
	}
{{/hasRequestModel}}
{{^hasRequestModel}}
	// The document describes this update as taking no body.
	var body interface{}
{{/hasRequestModel}}

{{#updateHasPathParams}}
	respBody, err := c.service.DoRequest(ctx, "{{updateMethod}}", fmt.Sprintf("{{updatePath}}"{{#parents}}, cr.Spec.ForProvider.{{goName}}{{/parents}}, id), body)
{{/updateHasPathParams}}
{{^updateHasPathParams}}
	respBody, err := c.service.DoRequest(ctx, "{{updateMethod}}", "{{updatePath}}", body)
{{/updateHasPathParams}}
	if err != nil {
		return managed.ExternalUpdate{}, errors.Wrap(err, errUpdate)
	}

	// The update's answer is NOT the read's. RT replies to a PUT with a list
	// of what it changed -- ["Queue Description changed from 'a' to 'b'"] --
	// and parsing that as the object fails on every successful update. The
	// next Observe reports the new state, which is where status.atProvider
	// comes from anyway.
	_ = respBody

	return managed.ExternalUpdate{}, nil
{{/hasUpdate}}
{{^hasUpdate}}
	// This API offers no update for a {{kindCamel}}. Observe therefore never
	// reports drift, so this is unreachable rather than silently doing
	// nothing -- but if it is reached, say so instead of reporting Synced.
	return managed.ExternalUpdate{}, errors.New("this API offers no update for a {{kindCamel}}; it must be deleted and recreated")
{{/hasUpdate}}
}

func (c *external) Delete(ctx context.Context, cr *{{apiVersion}}.{{kind}}) (managed.ExternalDelete, error) {
{{#hasDelete}}
	cr.Status.SetConditions(xpv2.Deleting())

	id := meta.GetExternalName(cr)
	if id == "" {
		// Never created; nothing to destroy.
		return managed.ExternalDelete{}, nil
	}

	// A 404 means someone else already did it, which is success as far as
	// reconciliation is concerned.
{{#deleteIsSet}}
	// The inverse of the set: this empties the owning resource's collection
	// rather than removing one member of it, so the external name is not
	// part of the path.
	_ = id
	_, err := c.service.DoRequest(ctx, "{{deleteMethod}}", {{#hasParents}}fmt.Sprintf("{{deletePath}}"{{#parents}}, cr.Spec.ForProvider.{{goName}}{{/parents}}){{/hasParents}}{{^hasParents}}"{{deletePath}}"{{/hasParents}}, nil)
{{/deleteIsSet}}
{{^deleteIsSet}}
{{#deleteHasPathParams}}
	_, err := c.service.DoRequest(ctx, "{{deleteMethod}}", fmt.Sprintf("{{deletePath}}"{{#parents}}, cr.Spec.ForProvider.{{goName}}{{/parents}}, id), nil)
{{/deleteHasPathParams}}
{{^deleteHasPathParams}}
	_, err := c.service.DoRequest(ctx, "{{deleteMethod}}", "{{deletePath}}", nil)
{{/deleteHasPathParams}}
{{/deleteIsSet}}
	if err != nil && !{{providerName}}.IsNotFound(err) {
		return managed.ExternalDelete{}, errors.Wrap(err, errDelete)
	}

	return managed.ExternalDelete{}, nil
{{/hasDelete}}
{{^hasDelete}}
	// This API offers no delete for a {{kindCamel}}. Erroring rather than
	// returning success, because success would let Crossplane remove the
	// finalizer and forget a {{kindCamel}} that still exists.
	return managed.ExternalDelete{}, errors.New("this API offers no delete for a {{kindCamel}}; it must be removed out of band")
{{/hasDelete}}
}

